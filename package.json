{
  "name": "alpha-archive",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Alpha Zone 世界观档案站",
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "dompurify": "3.4.16",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "marked": "18.0.14",
    "prettier": "3.9.9"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "validate": "node scripts/validate.mjs",
    "graph": "node scripts/graph.mjs",
    "vendor": "node scripts/vendor.mjs",
    "vendor:check": "node scripts/vendor.mjs --check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "build": "node scripts/build.mjs",
    "new-page": "node scripts/new-page.mjs",
    "check": "npm run vendor:check && npm run validate && npm run lint && npm run format:check && npm test && npm run build"
  }
}
