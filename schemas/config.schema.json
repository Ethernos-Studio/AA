{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alpha-archive.invalid/schemas/config.schema.json",
  "title": "Alpha Archive site configuration",
  "type": "object",
  "required": ["siteName", "defaultPage", "categories", "pageRegistry"],
  "properties": {
    "siteName": { "type": "string", "minLength": 1 },
    "domain": { "type": "string", "minLength": 1 },
    "footer": { "type": "string", "minLength": 1 },
    "defaultPage": { "$ref": "#/$defs/id" },
    "pageRegistry": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "file"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "file": { "type": "string", "pattern": "^pages/[A-Za-z0-9][A-Za-z0-9-]*\\.json$" }
        }
      }
    },
    "categories": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": {
        "type": "object",
        "required": ["id", "name", "parent"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "parent": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
          "archivePrefix": {
            "type": "string",
            "pattern": "^[A-Z]{2,6}$",
            "description": "Uppercase prefix for archive IDs in this category, e.g. ORG -> AZ-ORG-001. Declared here so the format lives in one place."
          },
          "subcategories": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/id" }
          },
          "pages": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/id" },
            "deprecated": true,
            "description": "Page membership comes from page JSON categories; omit this legacy field."
          }
        }
      }
    },
    "plannedPages": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": {
        "type": "object",
        "required": ["id", "title"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "title": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": { "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" } }
}
